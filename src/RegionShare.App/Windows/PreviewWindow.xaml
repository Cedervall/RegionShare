<Window x:Class="RegionShare.App.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Share Preview"
        Width="960"
        Height="540"
        MinWidth="320"
        MinHeight="180"
        Background="#030712">
    <Grid>
        <Border x:Name="PreviewViewport"
                BorderThickness="0"
                Background="#030712"
                SizeChanged="PreviewViewport_SizeChanged">
            <Grid x:Name="PreviewPlaceholder"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#111827">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform" />
                <TextBlock x:Name="CapturePlaceholderText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#D1D5DB"
                           FontSize="18"
                           Text="Capture preview will appear here" />
            </Grid>
        </Border>
    </Grid>
</Window>

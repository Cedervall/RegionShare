<Window x:Class="RegionShare.App.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Share Preview"
        Width="960"
        Height="540"
        MinWidth="320"
        MinHeight="180"
        Background="#111827">
    <Grid>
        <Border Margin="16"
                BorderBrush="#374151"
                BorderThickness="1"
                Background="#030712">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#D1D5DB"
                       FontSize="18"
                       Text="Capture preview will appear here" />
        </Border>
    </Grid>
</Window>

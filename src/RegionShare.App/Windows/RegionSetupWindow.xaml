<Window x:Class="RegionShare.App.Windows.RegionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Share FancyZones Setup"
        Width="640"
        Height="360"
        MinWidth="320"
        MinHeight="180"
        Background="#111827"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <Border Margin="8"
                BorderBrush="#22C55E"
                BorderThickness="3"
                Background="#1F2937">
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           Foreground="#D1D5DB"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Snap or resize this standard window with FancyZones or Windows Snap, then click Apply. The transparent green overlay is hidden while this setup window is active." />

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="16"
                            Orientation="Horizontal">
                    <Button MinWidth="90"
                            Padding="10,4"
                            Click="ApplyButton_Click"
                            Content="Apply" />
                    <Button Margin="8,0,0,0"
                            MinWidth="90"
                            Padding="10,4"
                            Click="CancelButton_Click"
                            Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

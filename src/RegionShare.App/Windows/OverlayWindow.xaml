<Window x:Class="RegionShare.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Share Overlay"
        Width="640"
        Height="360"
        MinWidth="320"
        MinHeight="180"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Window.Resources>
        <Style TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="FrameBorder"
                BorderBrush="#22C55E"
                BorderThickness="3"
                Background="#01000000">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="LockContextMenuItem"
                              Header="Lock region"
                              Click="LockToggle_Click" />
                </ContextMenu>
            </Border.ContextMenu>

            <TextBlock x:Name="SizeText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"
                       Padding="8,3"
                       Background="#CC111827"
                       Foreground="White"
                       FontWeight="SemiBold"
                       ToolTip="Unlocked region size"
                       Text="640 x 360" />
        </Border>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Orientation="Horizontal">
            <Button x:Name="LockToggleButton"
                    MinWidth="64"
                    Padding="8,3"
                    Background="#DD111827"
                    BorderBrush="#6B7280"
                    Foreground="White"
                    Click="LockToggle_Click"
                    Content="Lock" />
            <TextBlock x:Name="LockStatusText"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Padding="8,3"
                       Background="#CC111827"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Text="Unlocked" />
            <TextBlock x:Name="FrameTimingText"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Padding="8,3"
                       Background="#CC111827"
                       Foreground="White"
                       FontWeight="SemiBold"
                       Text="Latency -- ms | Frame -- ms" />
        </StackPanel>

        <primitives:Thumb x:Name="TopLeftResizeHandle"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          Cursor="SizeNWSE"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="TopResizeHandle"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          Margin="16,0"
                          Background="Transparent"
                          Cursor="SizeNS"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="TopRightResizeHandle"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          Cursor="SizeNESW"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="RightResizeHandle"
                          Width="10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Margin="0,16"
                          Background="Transparent"
                          Cursor="SizeWE"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="BottomRightResizeHandle"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Background="Transparent"
                          Cursor="SizeNWSE"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="BottomResizeHandle"
                          Height="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom"
                          Margin="16,0"
                          Background="Transparent"
                          Cursor="SizeNS"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="BottomLeftResizeHandle"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Background="Transparent"
                          Cursor="SizeNESW"
                          DragDelta="ResizeHandle_DragDelta" />
        <primitives:Thumb x:Name="LeftResizeHandle"
                          Width="10"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Stretch"
                          Margin="0,16"
                          Background="Transparent"
                          Cursor="SizeWE"
                          DragDelta="ResizeHandle_DragDelta" />
    </Grid>
</Window>

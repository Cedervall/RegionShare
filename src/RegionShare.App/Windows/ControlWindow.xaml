<Window x:Class="RegionShare.App.Windows.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegionShare Controls"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        Background="#F8FAFC">
    <Window.Resources>
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="RoundedComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="#E9EEF6"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="12,0,0,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#64748B"
                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False">
                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                            Margin="0,4,0,0"
                            Background="White"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="5">
                        <ScrollViewer MaxHeight="180">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="RoundedCheckBoxTemplate" TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="CheckBoxChrome"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Background="#E9EEF6"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Path x:Name="CheckMark"
                          Margin="3"
                          Stroke="White"
                          StrokeThickness="2"
                          Data="M 0 4 L 3 7 L 9 0"
                          Visibility="Collapsed" />
                </Border>
                <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckBoxChrome" Property="Background" Value="#0876BD" />
                    <Setter TargetName="CheckBoxChrome" Property="BorderBrush" Value="#0876BD" />
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
            <Setter Property="Background" Value="#0876BD" />
            <Setter Property="BorderBrush" Value="#0876BD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#D97706" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
            <Setter Property="Background" Value="#E9EEF6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource RoundedComboBoxTemplate}" />
            <Setter Property="Background" Value="#E9EEF6" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="#334155" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Template" Value="{StaticResource RoundedCheckBoxTemplate}" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SelectedPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Capture Region" />
                            <StackPanel Margin="0,6,0,14" Orientation="Horizontal">
                                <TextBlock x:Name="CaptureStatusDot"
                                           Margin="0,0,6,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="●" />
                                <TextBlock x:Name="CaptureStatusText"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Status: Stopped" />
                            </StackPanel>
                            <TextBlock x:Name="CaptureErrorText"
                                       Margin="0,0,0,8"
                                       Foreground="#B91C1C"
                                       FontWeight="SemiBold" />
                            <Button x:Name="CaptureToggleButton"
                                    Click="CaptureToggleButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Start Capture" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Overlay Management" />
                            <TextBlock x:Name="OverlayStatusText"
                                       Margin="0,6,0,14"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Overlay: Unlocked &amp; Visible" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OverlayLockToggleButton"
                                        Grid.Column="0"
                                        Click="OverlayLockToggleButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock x:Name="OverlayLockIcon" Margin="0,0,6,0" Text="&#x1F512;" />
                                            <TextBlock x:Name="OverlayLockText" Text="Lock Overlay" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#64748B" Text="Ctrl + Alt + L" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OverlayVisibilityToggleButton"
                                        Grid.Column="2"
                                        Click="OverlayVisibilityToggleButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock x:Name="OverlayVisibilityIcon" Margin="0,0,6,0" Text="&#x1F441;" />
                                            <TextBlock x:Name="OverlayVisibilityText" Text="Hide Overlay" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#64748B" Text="Ctrl + Alt + O" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FancyZonesSetupButton"
                                        Grid.Column="4"
                                        Click="FancyZonesSetupButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" Text="Snap Region" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#64748B" Text="Windows Snap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button x:Name="ResetWindowsButton"
                                    Margin="0,12,0,0"
                                    Click="ResetWindowsButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Reset Windows" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Region Size" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}" Text="Aspect Ratio" />
                                <UniformGrid Margin="0,10,0,0" Columns="4">
                                    <Button x:Name="AspectFreeButton" Margin="0,0,4,0" Tag="Free" Click="AspectRatioButton_Click" Content="Free" />
                                    <Button x:Name="AspectSixteenByNineButton" Margin="0,0,4,0" Tag="SixteenByNine" Click="AspectRatioButton_Click" Content="16:9" />
                                    <Button x:Name="AspectSixteenByTenButton" Margin="0,0,4,0" Tag="SixteenByTen" Click="AspectRatioButton_Click" Content="16:10" />
                                    <Button x:Name="AspectFourByThreeButton" Tag="FourByThree" Click="AspectRatioButton_Click" Content="4:3" />
                                </UniformGrid>
                                <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedTextStyle}" Text="Presets" />
                                <UniformGrid x:Name="PresetButtonsPanel" Margin="0,10,0,0" Columns="1" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock x:Name="CaptureFrameRateText" Style="{StaticResource MutedTextStyle}" Text="Capture FPS" />
                                <ComboBox x:Name="CaptureFrameRateComboBox"
                                          Margin="0,10,0,0"
                                          MinHeight="36"
                                          ItemStringFormat="{}{0} FPS"
                                          SelectionChanged="CaptureFrameRateComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Options" />
                                <CheckBox x:Name="CursorCaptureCheckBox"
                                          Margin="0,12,0,8"
                                          Checked="CursorCaptureCheckBox_Changed"
                                          Unchecked="CursorCaptureCheckBox_Changed"
                                          Content="Capture Cursor" />
                                <TextBlock x:Name="CursorCaptureRestartText"
                                           Margin="24,-4,0,8"
                                           Foreground="#D97706"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Restart capture to apply cursor capture changes."
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <CheckBox x:Name="BorderlessPreviewCheckBox"
                                          Margin="0,0,0,8"
                                          Checked="BorderlessPreviewCheckBox_Changed"
                                          Unchecked="BorderlessPreviewCheckBox_Changed"
                                          Content="Borderless Preview" />
                                <CheckBox x:Name="OverlayStatusCheckBox"
                                          Margin="0,0,0,8"
                                          Checked="OverlayStatusCheckBox_Changed"
                                          Unchecked="OverlayStatusCheckBox_Changed"
                                          Content="Show Overlay Status" />
                                <CheckBox x:Name="OverlayLatencyCheckBox"
                                          Checked="OverlayLatencyCheckBox_Changed"
                                          Unchecked="OverlayLatencyCheckBox_Changed"
                                          Content="Show Overlay Latency" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="AppVersionText"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Version unknown" />
        </StackPanel>
    </Grid>
</Window>
